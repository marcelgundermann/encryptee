{
	"$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
	// Vendored and kept in sync by the install-anti-slop skill, including rule sets encryptee doesn't use.
	"ignore": ["tools/oxlint/anti-slop/**"],
	"workspaces": {
		".": {},
		"apps/web": {
			// Every page's HTML links it as a stylesheet, which Knip doesn't follow, unlike its scripts.
			"entry": ["src/styles.css"]
		},
		"packages/engine": {
			// The bench script runs `vp dev --config bench/vite.config.ts`, whose page loads
			// bench.ts; Knip reads neither from a `vp` command line.
			"entry": ["bench/vite.config.ts", "bench/bench.ts"]
		}
	}
}
