{
	"name": "encryptee",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @encryptee/web dev",
		"build": "pnpm --filter @encryptee/web build",
		"preview": "pnpm --filter @encryptee/web preview",
		"lint": "oxlint --deny-warnings",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test",
		"knip": "knip",
		"check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test",
		"e2e": "pnpm --filter @encryptee/web e2e",
		"deploy:v1": "wrangler deploy -c deploy/v1/wrangler.jsonc"
	},
	"devDependencies": {
		"@oxlint/plugins": "catalog:",
		"knip": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:",
		"wrangler": "catalog:"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24",
			"onFail": "error"
		}
	},
	"packageManager": "pnpm@12.16.1"
}
