{
	"name": "encryptee",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp run @encryptee/web#dev",
		"build": "vp run @encryptee/web#build",
		"preview": "vp run @encryptee/web#preview",
		"fmt": "vp fmt",
		"typecheck": "vp run -r typecheck",
		"test": "vp run -r test",
		"check": "vp run fmt:check && vp run lint && vp run -r typecheck && vp run knip && vp run -r test",
		"e2e": "vp run @encryptee/web#e2e",
		"deploy:v1": "wrangler deploy -c deploy/v1/wrangler.jsonc"
	},
	"devDependencies": {
		"knip": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:",
		"wrangler": "catalog:"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.11.0 || >=26.0.0",
			"onFail": "error"
		}
	},
	"packageManager": "pnpm@12.16.1"
}
