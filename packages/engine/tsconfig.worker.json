{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["es2024", "esnext.array", "esnext.typedarrays", "webworker"],
		"types": ["vite/client"]
	},
	// tsconfig.dom.json's `exclude`, but the bench's Vite config. Vite reads `target` and
	// `verbatimModuleSyntax` from a file's config, so a file only a worker imports is named here too.
	"include": [
		"src/workers/*.worker.ts",
		"src/workers/answer-tool.ts",
		"src/workers/headers.ts",
		"src/workers/pipeline.ts",
		"src/workers/pool.ts",
		"src/workers/serve-headers.ts",
		"src/workers/source.ts",
		"src/sinks/open-sink.ts",
		"src/sinks/sw-route.ts"
	]
}
